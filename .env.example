# Copy this file to .env and fill in your local PostgreSQL password.
# .env is ignored by Git; never commit real passwords.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/geokitta

# Signs officer session cookies. Generate one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
